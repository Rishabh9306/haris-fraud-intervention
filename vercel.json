{
  "version": 2,
  "name": "haris-fraud-intervention",
  "builds": [
    {
      "src": "mock-server/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "mock-server/server.js"
    },
    {
      "src": "/verify-identity",
      "dest": "mock-server/server.js"
    },
    {
      "src": "/freeze-card",
      "dest": "mock-server/server.js"
    },
    {
      "src": "/post-call-data",
      "dest": "mock-server/server.js"
    },
    {
      "src": "/call-log",
      "dest": "mock-server/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}
